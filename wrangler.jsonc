/**
 * Cloudflare Workers (정적 자산 + 짤 저장소) 배포 설정
 *
 * 앱 자체는 서버 코드가 없는 정적 SPA다. dist/ 를 그대로 서빙한다.
 * Worker 코드(worker/)는 토론방 짤 업로드·서빙(/api/media, /media/*)만 맡는다.
 * 정적 자산 요청은 Workers 요청 할당량에 포함되지 않는다(무료·무제한).
 *
 * not_found_handling: 'single-page-application'
 *   → 매칭되는 파일이 없는 경로(/content/tmdb-mv-123 등)에 index.html 을 200 으로 반환.
 *     Netlify 의 `/* → /index.html 200` 리다이렉트와 같은 역할.
 *     (public/_redirects 는 Netlify 롤백용으로 남겨둠)
 *
 * 배포: 빌드 `npm run build` → 배포 `npx wrangler deploy`
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ottcal",
  "compatibility_date": "2026-07-27",

  // 커스텀 도메인. custom_domain=true 면 배포 시 DNS 레코드와 인증서까지 자동 생성된다.
  // 대시보드에서 클릭으로 붙이는 것과 같은 결과이고, 설정이 repo 에 남아 재현 가능하다.
  "routes": [
    { "pattern": "ottcal.com", "custom_domain": true },
    { "pattern": "www.ottcal.com", "custom_domain": true }
  ],

  // routes 를 지정하면 workers.dev 주소가 자동으로 꺼진다.
  // DNS 전파 대기 없이 배포 결과를 바로 확인할 수 있는 검증용 주소로 살려둔다.
  // 중복 색인은 모든 페이지의 canonical 이 ottcal.com 을 가리켜 방지된다.
  "workers_dev": true,

  // 토론방 짤 저장소(R2) — worker/index.ts 참고.
  // ⚠️ 이 버킷이 Cloudflare 계정에 없으면 **배포 자체가 실패한다.** main 에 머지하기 전에
  //    대시보드 R2 에서 'ottcal-media' 버킷을 먼저 만든다.
  "main": "worker/index.ts",
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "ottcal-media" }
  ],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // 이 경로만 Worker 가 먼저 받는다. 나머지는 지금처럼 정적 자산이 먼저라
    // Worker 요청 할당량(무료 하루 10만)을 쓰지 않는다.
    "run_worker_first": ["/api/*", "/media/*"],
    "not_found_handling": "single-page-application",

    // 기본값(auto-trailing-slash)은 /content/{id} 를 /content/{id}/ 로 307 리다이렉트한다.
    // canonical·sitemap 은 슬래시 없는 주소를 쓰므로 어긋난다 → 슬래시 없는 쪽을 정본으로 서빙.
    "html_handling": "drop-trailing-slash"
  }
}

# ── 이 파일을 복사해 .env 로 만들고 값을 채우세요 (.env 는 절대 커밋 금지) ──

# ── 프론트엔드(Vite) — 브라우저 공개용 키만 ──────────────────
# Supabase 대시보드 → Project Settings → API 에서 복사
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# (선택) 등록 모달의 작품 검색용 — TMDB v3 공개 읽기 키. 없으면 검색 비활성.
VITE_TMDB_API_KEY=YOUR-TMDB-V3-KEY

# ── 서버 전용(스크립트/GitHub Actions) — 절대 클라이언트 노출 금지 ──
# TMDB: Bearer 토큰(v4, 권장) 또는 api_key(v3) 중 하나 이상
# https://www.themoviedb.org/settings/api 에서 무료 발급
TMDB_ACCESS_TOKEN=
TMDB_API_KEY=YOUR-TMDB-V3-KEY
TMDB_LANGUAGE=ko-KR
TMDB_REGION=KR

# Supabase service_role (secret) — RLS 우회 upsert. sync/ingest 스크립트 전용.
SUPABASE_SERVICE_KEY=

# 웹푸시(VAPID) — 공개일 알림
# 공개키는 프런트에 박히는 공개값, 비밀키는 발송 스크립트 전용 secret.
# 새로 만들려면: node -e "console.log(require('web-push').generateVAPIDKeys())"
# ⚠️ 키를 갈아끼우면 기존 구독이 전부 무효가 되어 사용자가 알림을 다시 켜야 한다.
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# (선택) OTT 동기화 옵션
# MODE=full            # full | incremental
# START_DATE=2026-01-01
# END_DATE=2026-12-31
# CONCURRENCY=4
# MAX_PAGES=15

# ── 시드 재료 수집기(npm run signals) 전용 ───────────────────
# YouTube Data API v3 — 작품 반응을 모으는 데 쓴다. 무료(쿼터 10,000/일, 이 스크립트는 ~300).
# https://console.cloud.google.com → API 및 서비스 → YouTube Data API v3 사용 설정 → API 키
YOUTUBE_API_KEY=

# Supabase 연결 정보 (Supabase 대시보드 → Project Settings → API 에서 복사)
# 이 파일을 복사해 .env 로 만들고 값을 채우세요.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# TMDB 개봉·공개 예정작 수집기 (npm run ingest) 용 API 키
# https://www.themoviedb.org/settings/api 에서 무료 발급 (v3 auth)
TMDB_API_KEY=YOUR-TMDB-V3-KEY

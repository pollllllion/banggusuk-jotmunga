{
  "name": "doljikgu-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "prebuild": "npm run sitemap",
    "build": "vite build",
    "postbuild": "npm run prerender",
    "prerender": "node scripts/prerender.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "ingest": "node --env-file-if-exists=.env scripts/ingest-tmdb.mjs",
    "sync:ott": "node --env-file-if-exists=.env scripts/sync-tmdb-ott.mjs",
    "dedupe": "node --env-file-if-exists=.env scripts/merge-dups.mjs",
    "clean:media": "node --env-file-if-exists=.env scripts/clean-media.mjs",
    "payload": "node --env-file-if-exists=.env scripts/payload-check.mjs",
    "migrate:status": "node --env-file-if-exists=.env scripts/migrate-status.mjs",
    "migrate:mark": "node --env-file-if-exists=.env scripts/migrate-status.mjs mark",
    "enrich": "node --env-file-if-exists=.env scripts/enrich-tmdb.mjs",
    "personas:create": "node --env-file-if-exists=.env scripts/create-personas.mjs",
    "post": "node --env-file-if-exists=.env scripts/post-as.mjs",
    "signals": "node --env-file-if-exists=.env scripts/collect-signals.mjs",
    "push:release": "node scripts/send-release-push.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "@tanstack/react-query": "^5.99.0",
    "clsx": "^2.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.4",
    "vitest": "^4.1.10",
    "web-push": "^3.6.7",
    "wrangler": "^4.86.0"
  }
}

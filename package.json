{
  "name": "doljikgu-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "rss": "node scripts/generate-rss.mjs",
    "prebuild": "npm run sitemap && npm run rss",
    "build": "vite build",
    "postbuild": "npm run prerender",
    "prerender": "node scripts/prerender.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "preview": "vite preview",
    "ingest": "node --env-file-if-exists=.env scripts/ingest-tmdb.mjs",
    "sync:ott": "node --env-file-if-exists=.env scripts/sync-tmdb-ott.mjs",
    "dedupe": "node --env-file-if-exists=.env scripts/merge-dups.mjs",
    "gsc": "node --env-file-if-exists=.env scripts/fetch-gsc.mjs",
    "clean:media": "node --env-file-if-exists=.env scripts/clean-media.mjs",
    "payload": "node --env-file-if-exists=.env scripts/payload-check.mjs",
    "release-check": "node --env-file-if-exists=.env scripts/release-check.mjs",
    "migrate:status": "node --env-file-if-exists=.env scripts/migrate-status.mjs",
    "migrate:mark": "node --env-file-if-exists=.env scripts/migrate-status.mjs mark",
    "enrich": "node --env-file-if-exists=.env scripts/enrich-tmdb.mjs",
    "episodes": "node --env-file-if-exists=.env scripts/sync-next-episodes.mjs",
    "status": "node --env-file-if-exists=.env scripts/sync-status.mjs",
    "kofic": "node --env-file-if-exists=.env scripts/sync-kofic.mjs",
    "tmdb:gone": "node --env-file-if-exists=.env scripts/tmdb-gone.mjs",
    "backfill:origin": "node --env-file-if-exists=.env scripts/backfill-origin.mjs",
    "holidays": "node scripts/fetch-holidays.mjs",
    "personas:create": "node --env-file-if-exists=.env scripts/create-personas.mjs",
    "synopsis:export": "node --env-file-if-exists=.env scripts/synopsis.mjs export",
    "synopsis:apply": "node --env-file-if-exists=.env scripts/synopsis.mjs apply",
    "post": "node --env-file-if-exists=.env scripts/post-as.mjs",
    "signals": "node --env-file-if-exists=.env scripts/collect-signals.mjs",
    "push:release": "node scripts/send-release-push.mjs",
    "test": "vitest run",
    "naver": "node --env-file-if-exists=.env scripts/naver-sa.mjs",
    "naver:login": "node --env-file-if-exists=.env scripts/naver-sa.mjs --login",
    "indexnow": "node --env-file-if-exists=.env scripts/indexnow.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "@tanstack/react-query": "^5.99.0",
    "clsx": "^2.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "playwright-core": "^1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.4",
    "vitest": "^4.1.10",
    "web-push": "^3.6.7",
    "wrangler": "^4.86.0"
  }
}
